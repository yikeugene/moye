<Application x:Class="Moye.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <Style x:Key="SliderTrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent" Height="44"><Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2" VerticalAlignment="Center"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="TouchSlider" TargetType="Slider">
      <Setter Property="MinHeight" Value="44"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent" MinHeight="44">
        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
          <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource SliderTrackButton}" Background="#326AE8"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="44" Height="44"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Ellipse x:Name="Handle" Width="22" Height="22" Fill="White" Stroke="#326AE8" StrokeThickness="2"/></Grid><ControlTemplate.Triggers><Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Fill" Value="#DCE7FF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="StrokeThickness" Value="3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SliderTrackButton}" Background="#DCE2EC"/></Track.IncreaseRepeatButton>
        </Track>
        <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" IsHitTestVisible="False"/>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="#326AE8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="Accent" Color="#326AE8" />
    <SolidColorBrush x:Key="Ink" Color="#25334A" />
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI, Microsoft JhengHei UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#F1F3F7"/></Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="3,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#EAF0FD"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DCE7FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#326AE8"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#326AE8"/><Setter Property="Foreground" Value="White"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="PrimaryChrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryChrome" Property="Background" Value="#265BD0"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimaryChrome" Property="Background" Value="#214DB0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PrimaryChrome" Property="BorderBrush" Value="#A9C2FF"/><Setter TargetName="PrimaryChrome" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="44"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D9DFE8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="8,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D9DFE8"/><Setter Property="Background" Value="White"/></Style>
    <Style TargetType="ListBox"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="MenuItem"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12,8"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="10,8"/></Style>
    <Style TargetType="ContextMenu"><Setter Property="FontFamily" Value="Segoe UI, Microsoft JhengHei UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DFE4EC"/><Setter Property="Padding" Value="4"/></Style>
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="68"/><Setter Property="Height" Value="56"/><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="2,0"/></Style>
  </Application.Resources>
</Application>
